            "value": "Myself"
          }
        }
      }
    },
    "自分の性別": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your gender"
          }
        }
      }
    },
    "自分の生年月日": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your date of birth"
          }
        }
      }
    },
    "自分の生年月日をもとに、各年に何歳になるかを表示します。行をタップすると、その年のカレンダーが開きます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how old you are in each year, based on your date of birth. Tap a row to open that year's calendar."
          }
        }
      }
    },
    "自分の生年月日をもとに、各年に何歳になるかを表示します。行をタップすると、その年のカレンダーとメモが開きます。メモにはその年の出来事を書き留められます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how old you are in each year, based on your date of birth. Tap a row to open that year's calendar and note, where you can write down what happened that year."
          }
        }
      }
    },
    "自動": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        }
      }
    },
    "虎": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiger"
          }
        }
      }
    },
    "蛇": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snake"
          }
        }
      }
    },
    "表示モード": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display Mode"
          }
        }
      }
    },
    "表示範囲外のため %@年へ移動します": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside the range — moving to %@"
          }
        }
      }
    },
    "記念日": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anniversary"
          }
        }
      }
    },
    "記念日：%@年%@月%@日・%@周年": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anniversary: %@/%@/%@ · %@ years"
          }
        }
      }
    },
    "設定": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "誕生日": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birthday"
          }
        }
      }
    },
    "誕生日：%@年%@月%@日・満%@歳": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Born %@/%@/%@ · %@"
          }
        }
      }
    },
    "誕生日：%@年%@月%@日・満%@歳／数え%@歳": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Born %@/%@/%@ · %@ (traditional: %@)"
          }
        }
      }
    },
    "貨幣の改鋳が行われ、物価が落ち着いた時期とされます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The currency was recoined in this era, and prices are said to have settled."
          }
        }
      }
    },
    "賀寿は、節目の年齢に長寿を祝う習わしです。数え年で祝うのが本来ですが、今は満年齢で祝うことも増えています。\n\n還暦（61歳）だけは干支が一巡することに由来し、それ以外の多くは漢字の形の遊びから来ています。たとえば「喜」の草書体が「七十七」に見えることから喜寿（77歳）、「米」の字を分けると「八十八」になることから米寿（88歳）といった具合です。\n\n還暦に赤いちゃんちゃんこを贈るのは、赤ん坊に還るという意味と、赤が魔除けの色であることによります。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaju are the milestone ages at which long life is celebrated. Traditionally they follow the old age count, though celebrating by actual age is now common.\n\nOnly kanreki (61) comes from the calendar itself, marking one full turn of the sixty-year cycle. Most of the others are plays on the shapes of characters: the cursive form of 喜 resembles 七十七, giving kiju at 77; splitting 米 apart yields 八十八, giving beiju at 88.\n\nThe red vest given at kanreki carries two meanings at once — a return to infancy, and red as a colour that wards off misfortune."
          }
        }
      }
    },
    "赤い口": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Literally “red mouth”"
          }
        }
      }
    },
    "辛酉（かのととり）の年は変革が起きるとされ、その災いを避けるために改元されました。生麦事件と、その報復である薩英戦争が起きています。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shin'yū year was believed to bring upheaval, and the era name was changed to ward off the associated calamities. The Namamugi incident occurred here, and with it the retaliatory Anglo-Satsuma War."
          }
        }
      }
    },
    "追加": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        }
      }
    },
    "達人": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expert"
          }
        }
      }
    },
    "還暦をもう一度迎える年齢。60年周期を2度巡ったことを意味します。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The age at which kanreki comes round a second time — two complete turns of the sixty-year cycle."
          }
        }
      }
    },
    "金の兄（か のえ）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elder metal (yang)"
          }
        }
      }
    },
    "金の弟（か のと）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Younger metal (yin)"
          }
        }
      }
    },
    "鎖国の体制が固まった時期です。全国の国絵図と城絵図が幕府へ提出されました。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The era in which the seclusion system took firm shape. Provincial and castle maps from across the country were submitted to the shogunate."
          }
        }
      }
    },
    "長寿を祝う節目の年齢": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Milestone ages for celebrating long life"
          }
        }
      }
    },
    "長寿祝い": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "閉じる": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "関ヶ原の戦いと、徳川家康による江戸幕府の開府がありました。この一覧が始まる1600年は慶長5年にあたります。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The battle of Sekigahara was fought and Tokugawa Ieyasu founded the Edo shogunate. The year 1600, where this list begins, is Keichō 5."
          }
        }
      }
    },
    "馬": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horse"
          }
        }
      }
    },
    "鶏": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rooster"
          }
        }
      }
    },
    "黒船来航を受けた内裏炎上と地震により改元されました。日米修好通商条約の締結と、反対派を弾圧した安政の大獄が起きています。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name was changed after a palace fire and an earthquake, in the wake of the arrival of the Black Ships. The Treaty of Amity and Commerce with the United States was signed in this era, as was the Ansei Purge of those who opposed it."
          }
        }
      }
    },
    "龍": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragon"
          }
        }
      }
    }
  },
  "version": "1.0"
}
